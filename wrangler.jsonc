{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pup-analiytcs",
  "main": "server/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}

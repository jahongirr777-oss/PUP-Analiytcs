{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"pup-analiytcs",
 "main":"postgres/worker.mjs",
 "compatibility_date":"2026-11-17",
 "compatibility_flags":["nodejs_compat"],
 "vars":{"DB_GENERATION":"postgres-first-cutover"},
 "ratelimits":[{"name":"UPLOAD_RATE_LIMITER","namespace_id":"7771001","simple":{"limit":120,"period":60}}],
 "triggers":{"crons":["* * * * *"]},
 "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api","/api/*"]}
}
